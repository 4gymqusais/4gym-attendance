# Copy to .env and fill in real values. NEVER commit the real .env.

# Either name works. Railway's MongoDB plugin provisions MONGO_URL.
# Prefer Railway's INTERNAL host (mongodb.railway.internal) over the public
# *.proxy.rlwy.net proxy — the proxy sends your DB traffic over the internet.
MONGO_URI=mongodb://<user>:<password>@<host>:<port>/gym_attendance

# Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Leave PORT unset on Railway — the platform injects it. Locally it defaults to 5000.
# PORT=5000

NODE_ENV=development
